{{- /* TARGET paths (as they appear in $HOME). Rendered as a template. */ -}}

{{ if ne .role "workstation" -}}
# WezTerm only where it can run: the Mac. Not on the Centene VDI path.
.config/wezterm
# SSH client config (devbox alias etc.) is for the Mac only.
.ssh
{{- end }}

{{ if eq .role "work" -}}
# Client machines: bash instead of zsh, and no btop. Keeps the footprint small
# on images you don't control.
.zshrc
.zprofile
.zshenv
.config/btop
{{- end }}

{{ if not .full -}}
# Servers / the Proxmox host: shell, git, tmux. No toolchain, no full editor.
.config/mise
.config/nvim
.config/bat
.config/btop
# tms needs fzf, which comes from mise
.local/bin/tms
{{- end }}

{{ if ne .chezmoi.os "darwin" -}}
Library
{{- end }}
