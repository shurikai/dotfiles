# Managed by chezmoi. Own machines only: on client machines (.client) chezmoi
# leaves ~/.bashrc alone and only appends a block that sources the same file.
#
# Login shells get here through ~/.profile, which on Debian/Ubuntu sources
# ~/.bashrc; this repo doesn't manage ~/.profile.
case $- in *i*) ;; *) return ;; esac

[ -f "$HOME/.config/bash/personal.bash" ] && . "$HOME/.config/bash/personal.bash"
