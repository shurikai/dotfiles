# Managed by chezmoi: edit with `chezmoi edit ~/.config/mise/config.toml`.
# Changing this file re-runs `mise install` on the next `chezmoi apply`.
#
# Same tools at the same versions on every distro. Pin anything whose drift
# you've felt; bump on one machine, commit, `chezmoi update` elsewhere.

[tools]
# Editor
neovim = "0.12.5"   # if your current config misbehaves, pin to `nvim --version` from the old Mac
ripgrep = "latest"
fd = "latest"
fzf = "latest"

# Shell + terminal
starship = "latest"
tmux = "latest"
bat = "latest"
git-lfs = "latest"
{{- if ne .chezmoi.os "darwin" }}
# On macOS these come from Homebrew (mise's macOS builds for them are weak).
eza = "latest"
{{- end }}

# Languages (Java comes from SDKMAN, not mise)
{{- if not .client }}
# Client images ship their own Go, wired to their module proxy; use that one.
go = "latest"
{{- end }}
node = "lts"        # runtime for the npm-distributed language servers below
{{- if not .client }}
# Client images ship their own Python tooling. uv also fails there: mise
# verifies its download against sigstore, which locked-down networks block.
uv = "latest"
{{- end }}

# Neovim: language servers, formatters, debug adapter, treesitter CLI.
# Neovim finds them on PATH; nothing is installed from inside the editor.
tree-sitter = "latest"          # nvim-treesitter compiles parsers with it
lua-language-server = "latest"
stylua = "latest"
biome = "latest"
"github:Feel-ix-343/markdown-oxide" = "latest"
# ts_ls needs tsserver, which TypeScript 7 (native) no longer ships.
"npm:typescript" = "6"
"npm:typescript-language-server" = "latest"
"npm:yaml-language-server" = "latest"
"npm:@prisma/language-server" = "latest"
"go:golang.org/x/tools/gopls" = "latest"
"go:golang.org/x/tools/cmd/goimports" = "latest"   # conform.nvim, on save
# nvim-dap's JS adapter; lua/plugins/debugging.lua finds it with `mise where`.
"github:microsoft/vscode-js-debug" = { version = "latest", asset_pattern = "js-debug-dap-*.tar.gz" }
{{- if .client }}

[settings]
# mise looks up versions through its own server (mise-versions.jdx.dev) by
# default. Client networks can silently drop it, which costs three 20s
# timeouts per tool. Ask GitHub directly instead. That uses GitHub's API rate
# limit, so set MISE_GITHUB_TOKEN in ~/.config/bash/local.bash if mise hits it.
use_versions_host = false
{{- end }}
