[user]
	name = Jason Chestnut
{{- if .email }}
	email = {{ .email }}
{{- end }}
[init]
	defaultBranch = main
[core]
	editor = {{ if .full }}nvim{{ else }}vim{{ end }}
[color]
	ui = true
[credential "https://github.com"]
	useHttpPath = true
{{- if or .full (eq .chezmoi.os "darwin") }}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{- end }}
# Machine-local overrides kept out of the repo (work signing keys, etc.)
[include]
	path = ~/.config/git/local
