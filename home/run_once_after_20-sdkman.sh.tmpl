{{- if .full -}}
#!/bin/sh
# SDKMAN for Java. rcupdate=false: ~/.zshrc and ~/.config/bash/personal.bash source it,
# so the installer must not append to the managed rc files.
#
# Where get.sdkman.io is blocked (some client networks), this prints how to install it
# later and doesn't retry: run_once records the run either way.
set -eu
if [ ! -s "$HOME/.sdkman/bin/sdkman-init.sh" ]; then
    # Download first: a failed `curl | bash` would look like success.
    if script=$(curl -fsSL --connect-timeout 10 "https://get.sdkman.io?rcupdate=false"); then
        printf '%s\n' "$script" | bash
        echo "SDKMAN installed. Open a new shell, then e.g.: sdk install java"
    else
        echo "sdkman: get.sdkman.io unreachable. Install later with:" >&2
        echo "        curl -s 'https://get.sdkman.io?rcupdate=false' | bash" >&2
    fi
fi
{{ end -}}
