{{- $lazyLock := joinPath .chezmoi.workingTree "nvim" "lazy-lock.json" -}}
{{- if .full -}}
#!/bin/sh
# Puts Neovim plugins at exactly the revisions in the committed lockfile.
# Re-runs whenever the lockfile changes, i.e. after you pull an update made
# on another machine.
# lockfile hash: {{ if stat $lazyLock }}{{ include $lazyLock | sha256sum }}{{ else }}none{{ end }}
set -eu
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

# Only mise's Neovim: the config needs the pinned version, and a distro nvim
# found on PATH (often far older, e.g. apt's) can't run it.
if ! command -v mise >/dev/null 2>&1 || ! mise which nvim >/dev/null 2>&1; then
    echo "nvim-restore: mise's Neovim isn't installed yet, skipping. After 'mise install' succeeds, run: chezmoi apply" >&2
    exit 0
fi

# A failure here shouldn't abort the rest of chezmoi apply.
if [ -f "$HOME/.config/nvim/lazy-lock.json" ]; then
    if ! mise exec -- nvim --headless '+Lazy! restore' +qa </dev/null; then
        echo "nvim-restore: plugin restore failed. To see why, run:  nvim --headless '+Lazy! restore' +qa" >&2
    fi
fi
{{ end -}}
